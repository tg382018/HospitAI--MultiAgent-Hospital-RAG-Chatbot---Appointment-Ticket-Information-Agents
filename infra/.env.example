# Copy to infra/.env (gitignored) and tune:
#   cp infra/env.example infra/.env
#
# Defaults match backend/.env.example so the app can connect without edits.
# Host 5432 doluysa (başka Postgres): POSTGRES_PORT=5433 yapın ve backend/.env DATABASE_URL portunu eşleştirin.

POSTGRES_USER=hospitai
POSTGRES_PASSWORD=hospitai_dev_password
POSTGRES_DB=hospitai
POSTGRES_PORT=5432

REDIS_PORT=6379

# Chroma HTTP on host (container still listens on 8000).
CHROMA_HOST_PORT=8001

# XYZ Hospital reference API (optional `docker compose` service)
XYZ_HOSPITAL_PORT=8010
XYZ_HOSPITAL_AVAILABLE=true

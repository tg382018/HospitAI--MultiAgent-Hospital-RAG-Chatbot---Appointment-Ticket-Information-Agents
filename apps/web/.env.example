# Copy to frontend/.env.local — Vite reads VITE_* at build time.
# Default dev setup uses vite.config.ts proxy to http://127.0.0.1:8000
# VITE_API_BASE_URL=http://127.0.0.1:8000
#
# OpenAI / LLM API anahtarı buraya KONMAZ (tarayıcıya sızmamalı). backend/.env içinde
# OPENAI_API_KEY veya LLM_API_KEY + EMBEDDING_API_KEY kullanın.

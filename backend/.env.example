# Copy to backend/.env — see README.md
# Bu dosyada gerçek anahtar yok; değerleri yalnızca backend/.env içine yazın.

# Şifre + host portu, çalışan Docker Postgres ile aynı olmalı (`docker compose ps`: 15432->5432 ise 15432).
# Makinede 5432'de başka Postgres varsa URL yanlış sunucuya gider (şifre hatası gibi görünür).
# Eski volume farklı şifreyle oluşturulduysa şifreyi eşleştirin veya volume'ü silip yeniden `compose up`.
DATABASE_URL=postgresql+asyncpg://hospitai:hospitai_dev_password@127.0.0.1:5432/hospitai
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

JWT_SECRET=dev-only-change-me-min-16-chars-please-use-openssl
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# INTERNAL_API_KEY=

CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_COLLECTION_PREFIX=hospitai

# OPENAI_API_KEY=
# EMBEDDING_API_KEY=
# LLM_API_KEY=

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

LLM_MODEL=gpt-4o
# LLM_BASE_URL=
LLM_TEMPERATURE=0.25
MAX_CONVERSATION_HISTORY=20

# LANGCHAIN_API_KEY=
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=hospitai-dev
# TAVILY_API_KEY=

CHUNK_SIZE=500
CHUNK_OVERLAP=50

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

ALLOW_OPEN_REGISTRATION=true

# backend/.env şablonu — bu dosyayı backend/.env olarak kopyalayın:
#   cp backend/.env.example backend/.env
# Gerçek anahtarları yalnızca backend/.env içine yazın; bu dosyayı commitlemeyin.

# ============================================================
# ZORUNLU — bunlar olmadan uygulama çalışmaz
# ============================================================

# OpenAI API anahtarı (AI sohbet için gerekli)
OPENAI_API_KEY=

# JWT imzalama anahtarı — güçlü bir değer üretin:
#   openssl rand -hex 32
JWT_SECRET=dev-only-change-me-min-16-chars-please-use-openssl

# Admin paneli kayıt anahtarı — ilk admin hesabını açarken kullanılır.
# Üretimde tahmin edilemez bir değer seçin.
ADMIN_REGISTRATION_KEY=

# ============================================================
# OPSİYONEL — Docker Compose default değerleri çalışır
# ============================================================

# Veritabanı bağlantısı — Compose default şifresi ve portu (5432) için değişiklik gerekmez.
# Host'ta 5432 meşgulse: infra/.env içinde POSTGRES_PORT değiştir ve aşağıdaki portu eşleştir.
DATABASE_URL=postgresql+asyncpg://hospitai:hospitai_dev_password@127.0.0.1:5432/hospitai

ENVIRONMENT=development
LOG_LEVEL=INFO

# Üretimde gerçek domain adresinizi ekleyin.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Chroma vektör veritabanı — Compose default değerleri çalışır.
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_COLLECTION_PREFIX=hospitai

# LLM / Embedding modelleri
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.25
MAX_CONVERSATION_HISTORY=20

# Alternatif API anahtarları (OpenAI dışı sağlayıcı kullanılırsa)
# EMBEDDING_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=

# Sohbet limitleri
CHAT_MAX_MESSAGES_PER_CONVERSATION=100
CHAT_RATE_LIMIT=60/minute

# RAG chunk boyutları
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Celery (belge indeksleme worker'ı) — Redis Compose default değeriyle çalışır.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Açık kayıt (üretimde false yapın)
ALLOW_OPEN_REGISTRATION=true

# Misafir sohbet: tenant slug (X-Tenant-Slug gönderilmezse kullanılır)
# PUBLIC_CHAT_DEFAULT_TENANT_SLUG=demo-hospital

# Dahili API anahtarı (servisler arası çağrılar için isteğe bağlı)
# INTERNAL_API_KEY=

# Yüklenen logo/favicon dosyaları için dizin
# TENANT_ASSETS_DIR=data/tenant-assets

# Hastane köprüsü — gerçek HIS sistemine bağlanmak için
# HOSPITAL_BRIDGE_HTTP_BASE_URL=https://hastane-adresiniz.com
# HOSPITAL_BRIDGE_RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672//

# LangSmith izleme (isteğe bağlı)
# LANGCHAIN_API_KEY=
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=hospitai-dev

# Tavily arama aracı (isteğe bağlı)
# TAVILY_API_KEY=

{
  "name": "hospitai",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/admin"
  ],
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,json,md,yml,yaml}\" --ignore-path .gitignore",
    "lint": "npm run lint -w apps/web && npm run lint -w apps/admin",
    "dev": "npm run dev -w apps/web",
    "dev:admin": "npm run dev -w apps/admin",
    "build": "npm run build -w apps/web && npm run build -w apps/admin",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "docker:ps": "docker compose -f infra/docker-compose.yml ps"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,json,md,yml,yaml}": "prettier --write"
  }
}
